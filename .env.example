APP_NAME="StreetForge"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Company Legal Details
COMPANY_NAME="StreetForge Ltd"
COMPANY_NUMBER="14829103"
COMPANY_ADDRESS="128 City Road, London, EC1V 2NX, United Kingdom"
COMPANY_EMAIL="support@streetforge.co.uk"

# Namecheap PrivateEmail SMTP
MAIL_MAILER=smtp
MAIL_HOST=mail.privateemail.com
MAIL_PORT=465
MAIL_USERNAME=support@streetforge.co.uk
MAIL_PASSWORD=secret_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=support@streetforge.co.uk
MAIL_FROM_NAME="${COMPANY_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Corefy / Sterling Commerce API (live; base URL must include any provider API path)
COREFY_API_URL=https://api.sterling-pay.com
COREFY_ACCOUNT_ID=
COREFY_API_KEY=
COREFY_WEBHOOK_SECRET=
COREFY_SERVICE_CODE=auto
# corefy (official X-Signature), hmac_sha256 or hmac_sha1 (provider-specific)
COREFY_SIGNATURE_ALGORITHM=corefy

COREFY_LOG_ENABLED=true
